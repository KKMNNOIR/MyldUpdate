{
	"type": "minecraft:sequence",
	"sequence": [
		{
			"type": "minecraft:condition",
			"if_true": "minecraft:under_floor",
			"then_run": {
				"type": "minecraft:sequence",
				"sequence": [
					{
						"type": "minecraft:condition",
						"if_true": {
							"type": "minecraft:noise_threshold",
							"noise": "myld:overworld/rocky_desert_floor",
							"min_threshold": -1.6,
							"max_threshold": 1.0,
							"is_3d": false
						},
						"then_run": {
							"type": "minecraft:block",
							"result_state": "minecraft:packed_mud"
						}
					},
					{
						"type": "minecraft:condition",
						"if_true": {
							"type": "minecraft:noise_threshold",
							"noise": "myld:overworld/rocky_desert_floor",
							"min_threshold": -0.5,
							"max_threshold": 0.0,
							"is_3d": false
						},
						"then_run": {
							"type": "minecraft:block",
							"result_state": "minecraft:coarse_dirt"
						}
					},
					{
						"type": "minecraft:condition",
						"if_true": {
							"type": "minecraft:noise_threshold",
							"noise": "myld:overworld/rocky_desert_floor",
							"min_threshold": 0.0,
							"max_threshold": 0.2,
							"is_3d": false
						},
						"then_run": {
							"type": "minecraft:block",
							"result_state": "minecraft:sand"
						}
					}
				]
			}
		},
		{
			"type": "minecraft:condition",
			"if_true": {
				"type": "minecraft:stone_depth",
				"surface_type": "floor",
				"offset": -1,
				"add_surface_depth": true,
				"secondary_depth_range": 6
			},
			"then_run": {
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:noise_threshold",
					"noise": "myld:overworld/rocky_desert_floor",
					"min_threshold": -1.6,
					"max_threshold": 1.0,
					"is_3d": true
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "minecraft:packed_mud"
				}
			}
		},
		{
			"type": "minecraft:condition",
			"if_true": "minecraft:on_ceiling",
			"then_run": {
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:noise_threshold",
					"noise": "myld:overworld/rocky_desert_floor",
					"min_threshold": -1.6,
					"max_threshold": 1.0,
					"is_3d": true
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "minecraft:packed_mud"
				}
			}
		}
	]
