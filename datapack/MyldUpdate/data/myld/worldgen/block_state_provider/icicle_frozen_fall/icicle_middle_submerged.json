{
    "type": "minecraft:rule_based",
    "rules": [
        {
            "if_true": {
                "type": "minecraft:matching_fluids",
                "fluids": "minecraft:water"
            },
            "then": {
                "id": "minecraft:icicle",
                "properties": {
                    "vertical_direction": "down",
                    "thickness": "middle",
                    "attached": "false",
                    "waterlogged": "true"
                }
            }
        }
    ],
    "fallback": {
        "id": "minecraft:icicle",
        "properties": {
            "vertical_direction": "down",
            "thickness": "middle",
            "attached": "false"
        }
    }
}